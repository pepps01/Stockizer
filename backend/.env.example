FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# Must match the credentials in the repo-root .env used by docker-compose
DATABASE_URL=mysql+pymysql://algizer:change-me@127.0.0.1:3316/algizer?charset=utf8mb4
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@algizer.app
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# 1 = run the background Adviser worker inside the API process
ADVISER_WORKER=1
